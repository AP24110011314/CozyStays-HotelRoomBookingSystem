# Server Port (default 5001 to avoid conflict with macOS AirPlay receiver on port 5000)
PORT=5001

# Environment mode ('development', 'production', 'test')
NODE_ENV=development

# MongoDB Atlas Cloud Database connection URI (required; replace with your Atlas cluster credentials)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/hotel_booking?retryWrites=true&w=majority

# JWT signing secret (min 32 characters; generate using: openssl rand -base64 32)
JWT_SECRET=your-32-character-or-longer-jwt-secret-key-here

# JWT token expiration time (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=15m

# Client frontend URL(s) for CORS and email links (comma-separated if multiple origins)
CLIENT_URL=http://localhost:5173

# Booking cancellation window in hours before check-in (default: 48)
CANCELLATION_WINDOW_HOURS=48

# Maximum stay length in nights for any single booking (default: 30)
MAX_STAY_NIGHTS=30

# SMTP Configuration (Mailtrap for dev or your custom SMTP provider)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user_placeholder
SMTP_PASS=your_mailtrap_password_placeholder
SMTP_FROM=noreply@hotel-booking.test

# Optional alias for sender email address (overrides SMTP_FROM if set)
EMAIL_FROM=noreply@hotel-booking.test

# Currency (default: INR)
CURRENCY=INR

# Hotel Standard Check-in and Check-out Times
CHECK_IN_TIME="2:00 PM"
CHECK_OUT_TIME="11:00 AM"

# Payment Provider: 'mock' (default, simulated checkout with no keys) or 'razorpay' (real test/live keys)
PAYMENT_PROVIDER=mock

# Razorpay credentials (required only when PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_placeholder

# Minutes to hold unpaid room nights before auto-releasing
PAYMENT_HOLD_MINUTES=15